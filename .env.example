# Copy to .env and fill in. In Coolify, set these as environment variables instead.

# --- PocketBase superuser (the /_/ dashboard; optional auto-provision) ---
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-strong-password

# --- Author account for /admin (seeded once, on first boot) ---
PB_STAFF_EMAIL=you@example.com
PB_STAFF_PASSWORD=change-me-author-password

# --- Waitlist emails (Resend). Leave RESEND_API_KEY empty to disable sending. ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=The Salt Road <chapters@example.com>
# Used to build the "read it" link in the notification email.
APP_URL=https://saltroad.example.com

# --- Frontend ---
# Baked into the client bundle at BUILD time — changing it requires a rebuild.
VITE_POCKETBASE_URL=https://pb.example.com
# Used by SSR only; compose sets this to the internal service URL.
POCKETBASE_URL=http://pocketbase:8090
